*&---------------------------------------------------------------------*
*& Report ZBK_EGT_0016
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT zbk_egt_0016.

PARAMETERS:p_CARRID TYPE s_carr_id,
           p_CONNID TYPE s_conn_id,
           p_FLDATE TYPE s_date.

START-OF-SELECTION.
DATA: gs_flight TYPE sflight.
  SELECT SINGLE * FROM sflight INTO gs_flight
    WHERE
    carrid   = p_CARRID
  AND connid = p_CONNID
  AND fldate = p_FLDATE.
  CALL SCREEN 0100.
*&---------------------------------------------------------------------*
*& Module STATUS_0100 OUTPUT
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS '0100'.
  SET TITLEBAR '0100'.
ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  IF sy-ucomm = '&BACK'.
    SET SCREEN 0.
  ENDIF.
ENDMODULE.
